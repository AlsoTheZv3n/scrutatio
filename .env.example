# Copy to .env and fill in. Never commit the real .env.
#
# OpenRouter API key — https://openrouter.ai/keys
# Used for extraction (public trial text only) and for matching.
OPENROUTER_API_KEY=

# Optional overrides. The defaults are in src/scrutatio/config.py.
#
# Model for the bulk extraction pass. Changing this changes the extraction
# signature, which re-queues every trial — deliberate, but not free.
# EXTRACTION_MODEL=deepseek/deepseek-v4-flash

# Where the DuckDB file lives. Relative paths are resolved from the working
# directory; the parent is created on first use.
# DB_PATH=data/scrutatio.duckdb

# Refuse to start a bulk run whose projected cost exceeds this figure, in USD.
# MAX_SPEND_USD=25

# Concurrent extraction calls. OpenRouter publishes no limit for paid accounts,
# so this is measured rather than assumed. Raise on evidence, not on hope.
# EXTRACTION_WORKERS=4
