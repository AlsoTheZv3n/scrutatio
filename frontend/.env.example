# Copy to `.env` only if the backend is not where the default expects it.
#
# The default is http://127.0.0.1:8000, which is what `uv run scrutatio serve`
# binds. Set this when the API runs elsewhere:
#
#   VITE_API_BASE=http://127.0.0.1:8123
#
# Whatever origin THIS dev server runs on must also be allowed by the backend, or
# the browser blocks the response before the app ever sees it — and a CORS
# rejection is indistinguishable from the server being down. The backend allows
# ports 5173-5175 out of the box; for anything else set API_CORS_ORIGINS on the
# server side as well.

VITE_API_BASE=http://127.0.0.1:8000
